{
  "count": {
    "type": "slider",
    "value": 600,
    "min": 50,
    "max": 1500,
    "step": 10,
    "text": "Снег: количество снежинок"
  },
  "speed": {
    "type": "slider",
    "value": 60,
    "min": 5,
    "max": 400,
    "step": 1,
    "text": "Снег: скорость падения (меняется погодой, если она включена)"
  },
  "angle": {
    "type": "slider",
    "value": 0,
    "min": -70,
    "max": 70,
    "step": 1,
    "text": "Снег: угол падения (меняется погодой, если она включена)"
  },
  "size": {
    "type": "slider",
    "value": 4,
    "min": 1,
    "max": 20,
    "step": 0.5,
    "text": "Снег: размер снежинок"
  },
  "particleColor": {
    "type": "color",
    "value": "255,255,255",
    "text": "Снег: цвет снежинок"
  },
  "bgColor": {
    "type": "color",
    "value": "0,0,0",
    "text": "Фон: цвет фона"
  },
  "sway": {
    "type": "checkbox",
    "value": true,
    "text": "Покачивание: снежинки покачиваются в воздухе"
  },
  "swayAmount": {
    "type": "slider",
    "value": 6,
    "min": 0,
    "max": 30,
    "step": 0.5,
    "text": "Покачивание: амплитуда (px)"
  },
  "swaySpeed": {
    "type": "slider",
    "value": 1,
    "min": 0.2,
    "max": 3,
    "step": 0.1,
    "text": "Покачивание: скорость"
  },
  "weather": {
    "type": "checkbox",
    "value": false,
    "text": "Погода: включить смену погоды (меняет скорость и угол)"
  },
  "weatherInterval": {
    "type": "slider",
    "value": 10,
    "min": 2,
    "max": 120,
    "step": 1,
    "text": "Погода: интервал смены (сек)"
  },
  "mouse": {
    "type": "checkbox",
    "value": false,
    "text": "Мышь: снежинки обходят курсор"
  },
  "mouseStrength": {
    "type": "slider",
    "value": 5,
    "min": 1,
    "max": 10,
    "step": 0.5,
    "text": "Мышь: скорость движения снежинок от курсора"
  },
  "mouseRadius": {
    "type": "slider",
    "value": 120,
    "min": 30,
    "max": 400,
    "step": 5,
    "text": "Мышь: радиус курсора (px)"
  },
  "parallax": {
    "type": "checkbox",
    "value": false,
    "text": "Параллакс: камера двигается за мышкой"
  },
  "parallaxStrength": {
    "type": "slider",
    "value": 5,
    "min": 1,
    "max": 10,
    "step": 0.5,
    "text": "Параллакс: сила эффекта"
  }
}
